{
  "name": "my-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source collection of Pi extensions and locally modified packages",
  "license": "MIT",
  "author": "xiaotianxt",
  "repository": "github:xiaotianxt/my-pi-extensions",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/copy-code.ts",
      "./extensions/polished-footer.ts",
      "./extensions/deepseek-usage.ts",
      "./extensions/openai-codex.ts",
      "./extensions/codex-diagnostics.ts",
      "./extensions/herdr-agent-state.ts",
      "./extensions/herdr-tab-title.ts",
      "./extensions/herdr-ui-state.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^26.0.0",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "privacy": "python3 scripts/privacy-check.py",
    "check": "npm run privacy && npm run typecheck && npm test"
  }
}
